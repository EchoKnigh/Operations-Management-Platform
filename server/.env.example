# Copy to server/.env for local development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newtonite
# Used only by `npm test` (the test run DROPS the public schema!). Must be a different database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newtonite_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Set to true for managed Postgres that requires SSL (Render, Railway, Neon...)
DATABASE_SSL=false
# Optional: restrict browser origins (default: reflect any origin)
# CORS_ORIGIN=https://your-frontend.example.com
